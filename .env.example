HOST=0.0.0.0
PORT=8001
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx...) so rate
# limits use the real client IP from X-Forwarded-For. Leave unset otherwise.
TRUST_PROXY=

# Limits
RATE_LIMIT_LOOKUPS_PER_MINUTE=30
RATE_LIMIT_DOWNLOADS_PER_HOUR=20
MAX_CONCURRENT_DOWNLOADS=2
MAX_PENDING_DOWNLOADS=10
# Finished files not fetched within this time are deleted
FILE_TTL_SECONDS=900
INFO_CACHE_TTL_SECONDS=300

# Optional: proxy and cookies for cloud IPs that YouTube blocks.
# Use a throwaway Google account, never your personal one.
YOUTUBE_PROXY=
YOUTUBE_COOKIES_TEXT=
YOUTUBE_COOKIE_FILE=
